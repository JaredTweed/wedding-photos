rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function hasDonated() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/donations/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/donations/$(request.auth.uid)).data.get('hasDonated', false) == true
          || get(/databases/$(database)/documents/donations/$(request.auth.uid)).data.get('couponCode', '') == "FREEWEDDING"
        );
    }

    match /donations/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['couponCode'])
        && request.resource.data.couponCode == "FREEWEDDING";

      // A paid donation document can contain server-managed fields such as
      // hasDonated. Applying the public coupon must preserve those fields.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['couponCode'])
        && request.resource.data.couponCode == "FREEWEDDING";
    }

    match /sites/{slug} {
      allow read: if true;

      allow create: if isSignedIn()
        && hasDonated()
        && request.resource.data.slug == slug
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'title', 'slug', 'primaryColor', 'region', 'idPool', 'bucket', 'icoImage', 'createdBy', 'createdAt', 'plan', 'objectPrefix', 'fontFamily', 'theme'
        ])
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['managed', 'self-managed'])
        && (!('objectPrefix' in request.resource.data) || request.resource.data.objectPrefix is string)
        && (!('fontFamily' in request.resource.data) || request.resource.data.fontFamily is string)
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['classic', 'refined']);

      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && hasDonated()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.keys().hasOnly([
          'title', 'slug', 'primaryColor', 'region', 'idPool', 'bucket', 'icoImage', 'createdBy', 'createdAt', 'plan', 'objectPrefix', 'fontFamily', 'theme'
        ])
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['managed', 'self-managed'])
        && (!('objectPrefix' in request.resource.data) || request.resource.data.objectPrefix is string)
        && (!('fontFamily' in request.resource.data) || request.resource.data.fontFamily is string)
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['classic', 'refined']);

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
